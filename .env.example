OPENAI_API_KEY=
# Required for local authenticated sessions. Use a unique random value with at
# least 32 characters; never commit a real value.
LOCAL_AUTH_SIGNING_KEY=

# Optional local SQLite database for Mastra storage and the Phase 002 local runtime.
# Use a dedicated local file while developing. Tests always replace this with a temporary file and
# never use an inherited remote URL. Remote adapters are deliberately outside this phase.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Default is deterministic local ingress. Keep this as `mock` unless an
# explicitly configured Intercom development workspace is being exercised.
SUPPORT_SOURCE=mock

# Opt-in Intercom development adapter (API version is pinned in source to 2.16).
# No value below is a production default. Do not commit tokens or client secrets.
# SUPPORT_SOURCE=intercom
# INTERCOM_DEVELOPMENT_ENABLED=true
# The template's existing local staff/customer identities are tenant local-demo.
# Other tenant IDs fail explicitly; this prevents remote cases reading local data.
# INTERCOM_TENANT_ID=local-demo
# INTERCOM_APP_ID=your_intercom_app_id
# INTERCOM_ACCESS_TOKEN=
# INTERCOM_CLIENT_SECRET=
# INTERCOM_ADMIN_ID=
# Optional only for fake HTTP tests; production/development uses api.intercom.io over HTTPS.
# INTERCOM_API_BASE_URL=https://api.intercom.io
# Optional structured escalation: Conversation stays canonical; a Ticket is
# created only for an escalated case when this type id is configured.
# INTERCOM_TICKET_TYPE_ID=
# INTERCOM_TICKET_STATE_ID=
# Disabled by default. When true, published Intercom Articles are read through
# the existing sealed knowledge publication lifecycle; local knowledge remains
# selected otherwise.
# INTERCOM_KNOWLEDGE_ENABLED=false
# Required Intercom permissions: read/write conversations; read contacts;
# read/write tickets only when ticket conversion is enabled; read/list articles
# only when knowledge sync is enabled. Configure webhook topics only for
# conversation.user.created and conversation.user.replied.

# DEC-015 retention defaults. Values may only shorten the approved windows.
SUPPORT_RETENTION_RAW_PAYLOAD_DAYS=7
SUPPORT_RETENTION_CASE_DAYS=90
SUPPORT_RETENTION_TRACE_DAYS=30
SUPPORT_RETENTION_FINANCIAL_AUDIT_DAYS=365
# Runtime cleanup checks every 24 hours (minimum 60 seconds; maximum 7 days).
SUPPORT_RETENTION_SWEEP_MS=86400000
# Run a one-off local sweep with `npm run local:retention`. It refuses remote URLs.
