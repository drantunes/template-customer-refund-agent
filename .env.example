OPENAI_API_KEY=

# Optional local SQLite database for Mastra storage and the Phase 002 local runtime.
# Use a dedicated local file while developing. Tests always replace this with a temporary file and
# never use an inherited remote URL. Remote adapters are deliberately outside this phase.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The Phase 001 baseline supports the built-in mock adapter only. Unsupported values return an
# explicit diagnostic; no external support provider is included yet.
SUPPORT_SOURCE=mock
