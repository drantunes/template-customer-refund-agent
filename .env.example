OPENAI_API_KEY=
# Required for local authenticated sessions. Use a unique random value with at
# least 32 characters; never commit a real value.
LOCAL_AUTH_SIGNING_KEY=

# Optional local SQLite database for Mastra storage and the Phase 002 local runtime.
# Use a dedicated local file while developing. Tests always replace this with a temporary file and
# never use an inherited remote URL. Remote adapters are deliberately outside this phase.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The Phase 001 baseline supports the built-in mock adapter only. Unsupported values return an
# explicit diagnostic; no external support provider is included yet.
SUPPORT_SOURCE=mock

# DEC-015 retention defaults. Values may only shorten the approved windows.
SUPPORT_RETENTION_RAW_PAYLOAD_DAYS=7
SUPPORT_RETENTION_CASE_DAYS=90
SUPPORT_RETENTION_TRACE_DAYS=30
SUPPORT_RETENTION_FINANCIAL_AUDIT_DAYS=365
# Runtime cleanup checks every 24 hours (minimum 60 seconds; maximum 7 days).
SUPPORT_RETENTION_SWEEP_MS=86400000
# Run a one-off local sweep with `npm run local:retention`. It refuses remote URLs.
