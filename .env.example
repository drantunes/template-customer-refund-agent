OPENAI_API_KEY=

# Optional: libSQL/Turso database for Mastra storage and the case store (src/mastra/lib/case-store.ts).
# Defaults to the local file:./mastra.db used by `mastra dev`. Set these for any real deployment -
# `mastra env db create --kind turso` provisions and injects them automatically on Mastra platform.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The Phase 001 baseline supports the built-in mock adapter only. Unsupported values return an
# explicit diagnostic; no external support provider is included yet.
SUPPORT_SOURCE=mock
