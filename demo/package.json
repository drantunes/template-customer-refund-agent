{
  "name": "support-customer-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=../.env dist/server.js",
    "seed": "npm run build && node --env-file-if-exists=../.env dist/seed.js",
    "format:check": "prettier --check src test package.json tsconfig.json",
    "lint": "oxlint --deny-warnings src test",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test -c playwright.config.ts",
    "e2e:serve": "node dist/e2e-seed.js && node dist/server.js",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@libsql/client": "0.17.4",
    "hono": "4.13.7"
  }
}
