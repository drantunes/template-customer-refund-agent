{
  "name": "mastra-customer-refund-agent",
  "version": "1.0.0",
  "description": "A template Mastra app demonstrating a customer support agent that triages inbound messages, drafts grounded responses from a policy knowledge base, and requests human approval before issuing refunds.",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs ./node_modules/mastra/dist/index.js dev",
    "build": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs ./node_modules/mastra/dist/index.js build",
    "build:web": "npm run --workspace support-refund-agent-web build",
    "check:runtime": "node scripts/check-runtime.mjs",
    "start": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs ./node_modules/mastra/dist/index.js start",
    "check:env": "node --env-file-if-exists=.env scripts/check-env.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke:clean": "node scripts/clean-clone-smoke.mjs",
    "local:seed": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs scripts/local-fixtures.mjs seed",
    "local:reset": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs scripts/local-fixtures.mjs reset",
    "local:retention": "node --env-file-if-exists=.env --import ./scripts/database-env.mjs scripts/retention.mjs",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "lint": "oxlint --deny-warnings src test",
    "lint:web": "npm run --workspace support-refund-agent-web lint",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm run --workspace support-refund-agent-web typecheck",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:eval": "node scripts/require-eval-baseline.mjs && vitest run --project eval",
    "eval:candidate-report": "node scripts/eval-candidate-report.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run --workspace support-refund-agent-web test:unit && npm run test:integration && npm run --workspace support-refund-agent-web test:integration && npm run test:contract && npm run --workspace support-refund-agent-web test:contract && npm run test:eval && npm run --workspace support-refund-agent-web test:eval"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@mastra/core": "1.63.2",
    "@mastra/evals": "1.9.0",
    "@mastra/libsql": "1.22.2",
    "@mastra/loggers": "1.3.0",
    "@mastra/memory": "1.28.1",
    "@mastra/observability": "1.17.4",
    "@mastra/rag": "2.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "mastra": "1.27.2",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
